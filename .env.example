# =============================================================================
# Discord Music Bot Configuration
# Copy this file to .env and fill in the values
# =============================================================================

# --- Required ---

# Discord bot token (from https://discord.com/developers/applications)
BOT_TOKEN=your_discord_bot_token_here

# --- Bot Settings ---

# Default command prefix (can be overridden per-guild)
BOT_PREFIX=!

# Bot owner ID (for owner-only commands like !reload, !sync)
# If not set, uses the application owner from Discord
BOT_OWNER_ID=

# --- Database ---

# Database URL. SQLite (default) or PostgreSQL
# SQLite:     sqlite+aiosqlite:///data/bot.db
# PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/musicbot
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# --- Lavalink (Default audio backend) ---

# Enable Lavalink as the audio backend (set to false to use native FFmpeg)
LAVALINK_ENABLED=true

# Lavalink server connection details
LAVALINK_HOST=localhost
LAVALINK_PORT=8080
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# --- FFmpeg (Fallback audio backend) ---

# Path to FFmpeg executable (if not in PATH)
FFMPEG_PATH=ffmpeg

# --- Spotify (Optional - for playlist import) ---

# Spotify API credentials (from https://developer.spotify.com/dashboard)
# If not set, /playlist import for Spotify URLs will be disabled
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# --- Logging ---

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path (set to empty to disable file logging)
LOG_FILE=logs/bot.log

# --- Feedback ---

# Feedback destination (priority: webhook > channel > DM owner)
# Discord webhook URL for feedback messages
FEEDBACK_WEBHOOK_URL=

# Channel ID for feedback messages
FEEDBACK_CHANNEL_ID=

# If both above are empty, feedback is DM'd to the bot owner

# --- Auto-Update ---

# Auto-update yt-dlp on startup
YTDLP_AUTO_UPDATE=true
