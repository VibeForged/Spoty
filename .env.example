# =============================================================================
# Discord Music Bot Configuration
# Copy this file to .env and fill in the values
# =============================================================================

# --- Required ---

# Discord bot token (from https://discord.com/developers/applications)
BOT_TOKEN=your_discord_bot_token_here

# --- Bot Settings ---

# Default command prefix (can be overridden per-guild)
BOT_PREFIX=!

# Bot owner ID (for owner-only commands like !reload, !sync)
# If not set, uses the application owner from Discord
BOT_OWNER_ID=

# --- Database ---

# Database URL. SQLite (default) or PostgreSQL
# SQLite:     sqlite+aiosqlite:///data/bot.db
# PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/musicbot
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# --- Lavalink (Default audio backend) ---

# Enable Lavalink as the audio backend (set to false to use native FFmpeg)
LAVALINK_ENABLED=true

# Lavalink server connection details
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=8080
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# --- FFmpeg (Fallback audio backend) ---

# Path to FFmpeg executable (if not in PATH)
FFMPEG_PATH=ffmpeg

# --- Spotify (Optional - for playlist import) ---

# Spotify API credentials (from https://developer.spotify.com/dashboard)
# If not set, /playlist import for Spotify URLs will be disabled
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# --- yt-dlp (Optional - for age-restricted content) ---

# Path to Netscape-format cookies file for YouTube authentication
# Required for age-restricted videos. See yt-dlp wiki for export instructions:
# https://github.com/yt-dlp/yt-dlp/wiki/Extractors#exporting-youtube-cookies
YTDLP_COOKIES_FILE=

# --- Last.fm (Optional - for Auto-DJ recommendations) ---

# Last.fm API key for better Auto-DJ recommendations
LASTFM_API_KEY=

# --- Logging ---

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path (set to empty to disable file logging)
LOG_FILE=logs/bot.log

# --- Feedback ---

# Feedback destination (priority: webhook > channel > DM owner)
# Discord webhook URL for feedback messages
FEEDBACK_WEBHOOK_URL=

# Channel ID for feedback messages
FEEDBACK_CHANNEL_ID=

# If both above are empty, feedback is DM'd to the bot owner

# --- Auto-Update ---

# Auto-update yt-dlp on startup
YTDLP_AUTO_UPDATE=true

# --- Packaged Runtime Overrides (Optional) ---

# Override user data directory for packaged launcher
# Windows default: %APPDATA%/Spoty
# Linux default:   ~/.config/spoty
SPOTY_USER_DIR=

# Override bundled Lavalink directory path
SPOTY_LAVALINK_DIR=

# Override bundled Java executable path
SPOTY_JAVA_BIN=

# Override bundled FFmpeg executable path
SPOTY_FFMPEG_BIN=

# Skip bundled Lavalink startup and use external Lavalink_* settings
SPOTY_SKIP_LAVALINK=false

# Advanced: override env file location used by BotConfig
SPOTY_ENV_FILE=

# --- Build Script Variables (Reference) ---

# Used by scripts/build-windows.ps1 and scripts/build-linux.sh
# Path to extracted JRE directory to bundle in release artifacts
SPOTY_JRE_DIR=

# Path to FFmpeg directory to bundle in release artifacts
# Expected structure includes bin/ffmpeg(.exe)
SPOTY_FFMPEG_DIR=

# Build version used for version.json and artifact metadata
APP_VERSION=1.0.0
